rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'beyle931224@gmail.com';
    }

    match /contact_messages/{messageId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'contact', 'category', 'message', 'status', 'createdAt', 'source']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 40 &&
        request.resource.data.contact is string && request.resource.data.contact.size() <= 100 &&
        request.resource.data.category in ['一般詢問', '活動／法會', '網站建議', '宗教文化', 'AI 智慧服務', '線上抽籤', '其他'] &&
        request.resource.data.message is string && request.resource.data.message.size() >= 2 && request.resource.data.message.size() <= 1000 &&
        request.resource.data.status == 'new' &&
        request.resource.data.source == 'official-website' &&
        request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['new', 'read', 'replied'];
      allow delete: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.title == '丙午年農曆10月6至7日宜蘭三清宮進香神尊名冊' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content']) &&
        request.resource.data.content == '進香日期：丙午年農曆10月6至7日\n進香地點：宜蘭三清宮\n名冊確認：農曆9月1日晚上博杯\n\n堂內神尊（8尊）\n1. 李府千歲\n2. 天師祖\n3. 中壇元帥\n4. 二郎神君\n5. 朱府千歲\n6. 關聖帝君\n7. 虎爺\n8. 李府二千歲\n\n各家神尊（14尊）\n1. 簡家天師祖（簡O財）\n2. 宋家觀音佛祖（宋O秀）\n3. 鳳陽老母（王O雄）\n4. 中壇元帥（歐O喆）\n5. 詹家天師祖（邱O香）\n6. 福德正神（洪O成）\n7. 蘇家順天聖母（許O連）\n8. 葉家關聖帝君（葉O芸）\n9. 林家天師祖（林O坤）\n10. 李府千歲（蔡O文）\n11. 楊家觀音佛祖（邱O錦）\n12. 朱府千歲（陳O逞）\n13. 方家觀音佛祖（方O泰）\n14. 吳府千歲（吳O聰）'
      );
    }

    match /site_stats/{statId} {
      allow read: if statId in ['homepageVisits', 'divinationUses', 'annualFortuneUses', 'smallLiurenUses'];
      allow create: if statId in ['homepageVisits', 'divinationUses', 'annualFortuneUses', 'smallLiurenUses'] &&
        request.resource.data.keys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count == 1 &&
        request.resource.data.updatedAt == request.time;
      allow update: if statId in ['homepageVisits', 'divinationUses', 'annualFortuneUses', 'smallLiurenUses'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt']) &&
        request.resource.data.count == resource.data.count + 1 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
